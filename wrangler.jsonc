// Cloudflare Workers config, used by `wrangler dev` locally and `wrangler deploy` in Cloudflare builds.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "rahulrahul-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API calls run the Worker; pages and files are served directly (free and fast).
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Non-secret variables. Put secrets (API keys) in .dev.vars locally and in the
  // dashboard (Worker -> Settings -> Variables and Secrets) for production.
  "vars": {
    "CONTACT_TO_EMAIL": "rahul@rahulrahul.com.au",
    "CONTACT_FROM_EMAIL": "Website <website@rahulrahul.com.au>",
    "AWS_REGION": "us-east-1"
  }
}
