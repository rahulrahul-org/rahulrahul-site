---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found - Rahul">
  <section class="section">
    <div class="container" style="text-align:center; padding: 64px 0">
      <span class="eyebrow">404</span>
      <h1 class="section-title">This page doesn't exist</h1>
      <p style="color: var(--muted)">It may have moved during the site refresh.</p>
      <p><a class="btn btn-primary" href="/">Go home</a> <a class="btn btn-ghost" href="/blogs">Browse the blog</a></p>
    </div>
  </section>
</Base>
