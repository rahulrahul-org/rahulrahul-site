---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../utils';

const posts = await getPosts();
---

<Base
  title="Case Studies & Blogs - Rahul"
  description="Real enterprises' real transformation stories - context, method, result and learning."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Case Studies &amp; Blogs</span>
      <h1>Case Studies and Blogposts showcasing my experience and offerings</h1>
      <p>
        Stay informed, inspired, and ahead of the competition with curated collection of case studies and blogposts with problem,
        approach and learning. These posts are the testament of my learning and experience, which may be useful to regulated
        enterprises as well as starts ups / SMB.
      </p>
    </div>
  </section>

  <section class="section list">
    <div class="container posts">
      {posts.map((post, i) => <PostCard post={post} index={i} />)}
    </div>
  </section>
</Base>

<style>
  .page-hero {
    color: #fff;
    padding: 80px 0 72px;
    background:
      radial-gradient(600px 300px at 90% 0%, rgb(16 181 201 / 0.25), transparent 70%),
      linear-gradient(140deg, var(--hero-from), var(--hero-to));
  }
  .page-hero .eyebrow {
    color: #7cc0ff;
  }
  h1 {
    font-size: clamp(2rem, 4.2vw, 3rem);
    font-weight: 800;
    max-width: 820px;
  }
  .page-hero p {
    max-width: 760px;
    color: #c6d4ea;
    font-size: 1.08rem;
    margin: 0;
  }
  .list {
    padding-top: 64px;
  }
  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 980px) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .posts {
      grid-template-columns: 1fr;
    }
    .page-hero {
      padding: 56px 0 48px;
    }
  }
</style>
