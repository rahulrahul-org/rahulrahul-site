---
import { NAV, SITE } from '../site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container grid">
    <div>
      <a href="/" class="brand">{SITE.name}</a>
      <p class="muted">Cloud Data and AI Transformation Leader helping organisations modernise and build intelligent platforms.</p>
    </div>
    <div>
      <h4>Explore</h4>
      <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h4>Connect</h4>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href={SITE.phoneHref}>{SITE.phone}</a></li>
        {SITE.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <span>© {year} Rahul. All rights reserved.</span>
    <a href="#main">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--hero-from);
    color: #c9d6ea;
    padding: 64px 0 28px;
    margin-top: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
  }
  .brand {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.3rem;
    color: #fff;
    text-decoration: none;
  }
  .muted {
    color: #93a6c2;
    max-width: 360px;
  }
  h4 {
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }
  a {
    color: #c9d6ea;
    text-decoration: none;
  }
  a:hover {
    color: #fff;
  }
  .legal {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.88rem;
    color: #93a6c2;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
