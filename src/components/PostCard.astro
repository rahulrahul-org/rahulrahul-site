---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../utils';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const { title, description, pubDate, tags } = post.data;
// Each card gets one of a few gradient covers so the grid doesn't need stock photos.
const hue = [215, 195, 230, 205, 250, 185][index % 6];
---

<article class="post card" data-reveal>
  <a href={`/blogs/${post.id}`} class="cover" style={`--h:${hue}`} aria-hidden="true" tabindex="-1">
    <span>{tags[0] ?? 'Case Study'}</span>
  </a>
  <div class="body">
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </p>
    <h3><a href={`/blogs/${post.id}`}>{title}</a></h3>
    <p class="desc">{description}</p>
    <a href={`/blogs/${post.id}`} class="more">Read more <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .post {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .post:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: color-mix(in srgb, var(--brand) 40%, var(--border));
  }
  .cover {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 132px;
    padding: 1rem 1.25rem;
    text-decoration: none;
    background:
      radial-gradient(circle at 85% 20%, hsl(calc(var(--h) - 20) 90% 65% / 0.55), transparent 55%),
      linear-gradient(135deg, hsl(var(--h) 70% 22%), hsl(calc(var(--h) + 15) 75% 42%));
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .cover span {
    position: relative;
    z-index: 1;
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.25);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.4rem 1.4rem 1.5rem;
  }
  .meta {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  h3 {
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--brand);
  }
  .desc {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 1.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .more {
    margin-top: auto;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
  }
</style>
